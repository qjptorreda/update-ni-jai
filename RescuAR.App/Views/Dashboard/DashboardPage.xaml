<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:RescuAR.App.Views.Dashboard"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    xmlns:models="clr-namespace:RescuAR.App.Models"
    x:Class="RescuAR.App.Views.Dashboard.DashboardPage"
    x:DataType="vm:DashboardViewModel"
    Title="Home"
    BackgroundColor="#F8FAFC"
    Shell.NavBarIsVisible="False">


    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="16">
               
                <!-- 1. Hero User Greeting Banner Card -->
                <Border BackgroundColor="#0A8491" StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Greeting}" TextColor="#E0F2FE" FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding UserName}" TextColor="#FFFFFF" FontSize="28" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                           
                            <!-- Top Right USER Avatar Circle -->
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 24" StrokeThickness="2" Stroke="#FFFFFF" WidthRequest="48" HeightRequest="48" BackgroundColor="#0A8491" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="USER" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>


                        <!-- Emergency Status Banner Inside Hero -->
                        <Border BackgroundColor="#065F69" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAdvisoriesCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="{Binding RiverStatusText}" TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                <Border Grid.Column="1" BackgroundColor="#10B981" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,5" VerticalOptions="Center">
                                    <Label Text="{Binding RiverStatusPillText}" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>


                <!-- 1.5 Interactive Disaster Preparedness & AR Navigation Carousel -->
                <VerticalStackLayout Spacing="8">
                    <CarouselView ItemsSource="{Binding CarouselItems}"
                                  IndicatorView="carouselIndicator"
                                  HeightRequest="255"
                                  Loop="True"
                                  PeekAreaInsets="20">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="models:DashboardCarouselItem">
                                <Grid Padding="4">
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 24"
                                            HeightRequest="245"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=ExecuteCarouselActionCommand}"
                                                                 CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid>
                                            <!-- Background Photo -->
                                            <Image Source="{Binding ImageSource}"
                                                   Aspect="AspectFill"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill" />

                                            <!-- Gradient Dark Overlay -->
                                            <BoxView HorizontalOptions="Fill" VerticalOptions="Fill">
                                                <BoxView.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#40032B36" Offset="0.0" />
                                                        <GradientStop Color="#D8032B36" Offset="0.55" />
                                                        <GradientStop Color="#FA032B36" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </BoxView.Background>
                                            </BoxView>

                                            <!-- Card Content Layer -->
                                            <Grid RowDefinitions="*,Auto" Padding="20" RowSpacing="12">
                                                <!-- Title & Description -->
                                                <VerticalStackLayout Grid.Row="0" Spacing="6" VerticalOptions="End">
                                                    <Label Text="{Binding Title}"
                                                           TextColor="#FFFFFF"
                                                           FontSize="20"
                                                           FontAttributes="Bold" />
                                                    <Label Text="{Binding Description}"
                                                           TextColor="#E0F2FE"
                                                           FontSize="12"
                                                           LineBreakMode="WordWrap"
                                                           MaxLines="3" />
                                                </VerticalStackLayout>

                                                <!-- Action Button -->
                                                <Border Grid.Row="1"
                                                        BackgroundColor="#FFFFFF"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 16"
                                                        Padding="16,10"
                                                        HorizontalOptions="Start">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=ExecuteCarouselActionCommand}"
                                                                             CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding ButtonText}"
                                                           TextColor="#0A8491"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <!-- Carousel Page Indicator Dots -->
                    <IndicatorView x:Name="carouselIndicator"
                                   IndicatorColor="#CBD5E1"
                                   SelectedIndicatorColor="#0A8491"
                                   IndicatorSize="8"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,4" />
                </VerticalStackLayout>


                <!-- 2. Weather Forecast Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Weather Forecast" TextColor="#0F172A" FontSize="19" FontAttributes="Bold" Margin="4,0,0,0" />
                   
                    <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="20">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                           
                            <!-- Weather Text Info -->
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                          Fill="#0A8491" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                                    <Label Text="{Binding LocationName}" TextColor="#64748B" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>


                                <Label Text="{Binding WeatherTemperatureText}" TextColor="#0F172A" FontSize="36" FontAttributes="Bold" Margin="0,2,0,0" />


                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding WeatherConditionTitle}" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                                    <Label Text="{Binding WeatherConditionSummary}" TextColor="#64748B" FontSize="12" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>


                            <!-- Weather Cloud Icon Outline -->
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="70" HeightRequest="60">
                                <Path Data="M19.35,10.04C18.67,6.59,15.64,4,12,4C9.11,4,6.6,5.64,5.35,8.04C2.34,8.36,0,10.91,0,14c0,3.31,2.69,6,6,6h13c2.76,0,5-2.24,5-5C24,12.36,21.95,10.22,19.35,10.04z"
                                      Stroke="#94A3B8"
                                      StrokeThickness="3"
                                      Fill="Transparent"
                                      WidthRequest="64"
                                      HeightRequest="48"
                                      Aspect="Uniform"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>


                <!-- 3. PASS Preparedness Card -->
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPASSCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="PASS Preparedness" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding PreparednessScore, StringFormat='{0}%'}" TextColor="#0A8491" FontSize="32" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>


                        <Border BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,4" HorizontalOptions="Start">
                            <Label Text="{Binding PreparednessStatus}" TextColor="#0369A1" FontSize="11" FontAttributes="Bold" />
                        </Border>


                        <!-- Solid Teal Progress Bar -->
                        <ProgressBar Progress="{Binding ScoreProgress}" ProgressColor="#0A8491" HeightRequest="6" VerticalOptions="Center" />
                    </VerticalStackLayout>
                </Border>


                <!-- 4. Quick Actions -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Text="Quick Actions" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" Margin="4,0,0,0" />
                        <Border Grid.Column="1" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,6">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Path Data="M14.06,9.02l.92.92L5.92,19H5v-.92l9.06-9.06M17.66,3c-.25,0-.51.1-.7.29l-1.83,1.83,3.75,3.75,1.83-1.83c.39-.39.39-1.02,0-1.41l-2.34-2.34c-.2-.2-.45-.29-.71-.29zm-3.6,3.19L3,17.25V21h3.75L17.81,9.94l-3.75-3.75z"
                                      Fill="#334155" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                                <Label Text="Edit" TextColor="#334155" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="0">
                        <VerticalStackLayout Spacing="0">
                            <!-- Report Incident -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenReportsCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Path Data="M12 2L1 21h22M12 6l7.53 13H4.47M11 10v4h2v-4m-2 6v2h2v-2" Fill="#0A8491" WidthRequest="20" HeightRequest="20" Aspect="Uniform" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Report Incident" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="Report / Create a Report" TextColor="#94A3B8" FontSize="12" />
                                </VerticalStackLayout>
                                <Path Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#0F172A" WidthRequest="20" HeightRequest="20" Aspect="Uniform" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <!-- Emergency Hotlines -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenHotlinesCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Path Data="M20,10.5C20,15.65 15.65,20 10.5,20C5.35,20 1,15.65 1,10.5C1,5.35 5.35,1 10.5,1C14.73,1 18.3,3.83 19.5,7.74M10.5,3C6.36,3 3,6.36 3,10.5C3,14.64 6.36,18 10.5,18C14.64,18 18,14.64 18,10.5C18,6.36 14.64,3 10.5,3M9,13H7V11H9V13M14,13H12V11H14V13M10.5,6C11.33,6 12,6.67 12,7.5V9.5C12,10.33 11.33,11 10.5,11C9.67,11 9,10.33 9,9.5V7.5C9,6.67 9.67,6 10.5,6Z" Fill="#0A8491" WidthRequest="20" HeightRequest="20" Aspect="Uniform" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Emergency Hotlines" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="Prepare / Emergency Hotlines" TextColor="#94A3B8" FontSize="12" />
                                </VerticalStackLayout>
                                <Path Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#0F172A" WidthRequest="20" HeightRequest="20" Aspect="Uniform" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <!-- Evacuation Centers -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenEvacuationCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Path Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" Fill="#0A8491" WidthRequest="20" HeightRequest="20" Aspect="Uniform" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Find Nearest Evacuation Center" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="Prepare / Evacuation Centers" TextColor="#94A3B8" FontSize="12" />
                                </VerticalStackLayout>
                                <Path Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#0F172A" WidthRequest="20" HeightRequest="20" Aspect="Uniform" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <!-- Safety Circle -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenSafetyCircleCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Path Data="M15,5L9,2.89L3,5V21L9,18.89L15,21L21,18V5L15,5M15,19L9,16.89V4.11L15,6.22V19Z" Fill="#0A8491" WidthRequest="20" HeightRequest="20" Aspect="Uniform" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Safety Circle" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="Map / Safety Circle" TextColor="#94A3B8" FontSize="12" />
                                </VerticalStackLayout>
                                <Path Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#0F172A" WidthRequest="20" HeightRequest="20" Aspect="Uniform" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>


                <!-- 5. Area Status Overview Card (Dynamic Red/Yellow/Green live color matching Supabase) -->
                <ContentView>
                    <dashboard:AreaStatusOverviewPage />
                </ContentView>


                <!-- 6. Preparation Progress Card -->
                <ContentView>
                    <dashboard:PreparednessOverviewPage />
                </ContentView>


                <!-- Bottom PASS Widget -->
                <dashboard:PASSOverviewPage />


            </VerticalStackLayout>
        </ScrollView>


        <!-- Real-time SweetAlert Emergency Advisory Pop-Up Modal Overlay -->
        <Grid IsVisible="{Binding IsPopupVisible}" BackgroundColor="#90000000" Padding="20" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="380" StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="#FFFFFF" Padding="0">
                <VerticalStackLayout Spacing="0">
                   
                    <!-- Pop-up Header Banner -->
                    <Border BackgroundColor="{Binding SelectedAdvisory.AlertBadgeBg}" StrokeThickness="0" StrokeShape="RoundRectangle 24 24 0 0" Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="{Binding SelectedAdvisory.AlertBadgeText}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding SelectedAdvisory.HeaderTagText}" TextColor="{Binding SelectedAdvisory.AlertBadgeText}" FontSize="10" FontAttributes="Bold" />
                                <Label Text="{Binding SelectedAdvisory.DisplayAlertLevelText}" TextColor="{Binding SelectedAdvisory.AlertBadgeText}" FontSize="15" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            
                            <!-- Language Translation Dropdown Button -->
                            <Border Grid.Column="2" BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="{Binding SelectedAdvisory.AlertBadgeText}" StrokeShape="RoundRectangle 12" Padding="10,5" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenTranslationMenuCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="Translation" TextColor="{Binding SelectedAdvisory.AlertBadgeText}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="▾" TextColor="{Binding SelectedAdvisory.AlertBadgeText}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Close Button -->
                            <Border Grid.Column="3" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClosePopupCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="✕" TextColor="#64748B" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>


                    <!-- Pop-up Body Content -->
                    <ScrollView MaximumHeightRequest="420" Padding="20">
                        <VerticalStackLayout Spacing="14">
                            <!-- Title -->
                            <Label Text="{Binding SelectedAdvisory.DisplayTitleText}" TextColor="#0F172A" FontSize="19" FontAttributes="Bold" />


                            <!-- Message -->
                            <Label Text="{Binding SelectedAdvisory.DisplayMessageText}" TextColor="#334155" FontSize="13" LineBreakMode="WordWrap" CharacterSpacing="0.2" />


                            <!-- Recommended Action Plan -->
                            <Border IsVisible="{Binding SelectedAdvisory.HasActionPlan}" BackgroundColor="#FFFBEB" Stroke="#FDE68A" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding SelectedAdvisory.ActionPlanHeaderTagText}" TextColor="#B45309" FontSize="10" FontAttributes="Bold" />
                                    <Label Text="{Binding SelectedAdvisory.DisplayActionPlanText}" TextColor="#92400E" FontSize="12" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>


                            <!-- Affected Sectors -->
                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding SelectedAdvisory.AffectedAreaHeaderTagText}" TextColor="#64748B" FontSize="10" FontAttributes="Bold" />
                                    <Label Text="{Binding SelectedAdvisory.DisplayAffectedAreaText}" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>


                            <!-- Timestamp & Water Level -->
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Text="{Binding SelectedAdvisory.CreatedAtText}" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />
                                <Border Grid.Column="1" IsVisible="{Binding SelectedAdvisory.ShowWaterLevel}" BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                    <Label Text="{Binding SelectedAdvisory.WaterLevelText}" TextColor="#0284C7" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>


                    <!-- Pop-up Footer Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,16" BackgroundColor="#F8FAFC">
                        <Button Grid.Column="0" Text="{Binding SelectedAdvisory.CloseButtonText}" TextColor="#475569" BackgroundColor="#E2E8F0" CornerRadius="12" HeightRequest="44" FontSize="13" FontAttributes="Bold" Command="{Binding ClosePopupCommand}" />
                        <Button Grid.Column="1" Text="{Binding SelectedAdvisory.DetailsButtonText}" TextColor="#FFFFFF" BackgroundColor="#0A8491" CornerRadius="12" HeightRequest="44" FontSize="13" FontAttributes="Bold" Command="{Binding GoToAdvisoriesFeedCommand}" />
                    </Grid>


                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Permissions Pop-Up Modal Overlay (First-Time Users) -->
        <Grid IsVisible="{Binding IsPermissionsPopupVisible}" BackgroundColor="#90000000" Padding="20" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="340" StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="#FFFFFF" Padding="24">
                <VerticalStackLayout Spacing="16">
                    <!-- Icon -->
                    <Border BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 24" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center">
                        <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" 
                              Fill="#0EA5E9" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    
                    <Label Text="We need some permissions" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="To provide you with accurate safety routes and emergency alerts, RescuAR requires access to your location, camera, and notifications." TextColor="#64748B" FontSize="14" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    
                    <VerticalStackLayout Spacing="12" Margin="0,12,0,0">
                        <Button Text="Allow Permissions" TextColor="#FFFFFF" BackgroundColor="#0A8491" CornerRadius="12" HeightRequest="48" FontSize="15" FontAttributes="Bold" Command="{Binding GrantPermissionsCommand}" />
                        <Button Text="Skip for now" TextColor="#64748B" BackgroundColor="Transparent" FontSize="14" FontAttributes="Bold" Command="{Binding GrantPermissionsCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
