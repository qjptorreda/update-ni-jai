<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    x:Class="RescuAR.App.Views.Prepare.EvacuationCenterInfoPage"
    x:Name="thisPage"
    Title="Evacuation Centers"
    BackgroundColor="#F8FAFC">

    <ContentPage.BindingContext>
        <vm:EvacuationCenterInfoViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            
            <!-- Section 1: Emergency Hotlines Banner -->
            <VerticalStackLayout Spacing="14">
                <Label Text="Emergency Hotlines" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Hotlines}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmergencyHotlineItem">
                            <Border StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                                    
                                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="#E0F2FE">
                                        <Label Text="{Binding BadgeText}" TextColor="#0369A1" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                                        <Label Text="{Binding Number}" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" />
                                        <Label Text="{Binding Type}" TextColor="#64748B" FontSize="11" />
                                    </VerticalStackLayout>
                                    
                                    <!-- Direct Phone Call Button -->
                                    <Button Grid.Column="2" Text="Call" TextColor="#FFFFFF" BackgroundColor="#0A8491" CornerRadius="10" HeightRequest="38" FontSize="12" FontAttributes="Bold" Padding="14,0"
                                            Command="{Binding BindingContext.MakePhoneCallCommand, Source={x:Reference thisPage}}"
                                            CommandParameter="{Binding Number}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Section 2: Evacuation Centers Near Your Location -->
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="Evacuation Centers Near You" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Open Interactive Map" TextColor="#0A8491" BackgroundColor="#E0F2FE" CornerRadius="10" HeightRequest="36" FontSize="11" FontAttributes="Bold" Padding="10,0"
                            Command="{Binding NavigateToMapCommand}" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding EvacuationCenters}" Spacing="20">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EvacuationCenterItem">
                            <!-- Main Evacuation Center Card -->
                            <Border StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 18" BackgroundColor="#FFFFFF" Padding="18">
                                <VerticalStackLayout Spacing="14">
                                    
                                    <!-- Filter Chips Row & Bookmark Icon -->
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <Border Grid.Column="0" BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,6">
                                            <Label Text="GPS Nearby" TextColor="#0369A1" FontSize="12" FontAttributes="Bold" />
                                        </Border>
                                        
                                        <Border Grid.Column="1" BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="12,6">
                                            <Label Text="{Binding Distance}" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" />
                                        </Border>

                                        <!-- Bookmark Icon -->
                                        <Border Grid.Column="3" WidthRequest="32" HeightRequest="32" StrokeThickness="0" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 8" HorizontalOptions="End" VerticalOptions="Center">
                                            <Path Data="M17,3H7A2,2 0 0,0 5,5V21L12,18L19,21V5C19,3.89 18.1,3 17,3Z" Fill="Transparent" Stroke="#0F172A" StrokeThickness="1.5" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Evacuation Facility Image Banner -->
                                    <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" HeightRequest="170">
                                        <Grid>
                                            <Image Source="{Binding FacilityImageUrl}" Aspect="AspectFill" HeightRequest="170" />
                                            
                                            <!-- Dark Overlay for Readability -->
                                            <BoxView BackgroundColor="#20000000" VerticalOptions="Fill" HorizontalOptions="Fill" />

                                            <!-- Status Tag Overlay -->
                                            <Border BackgroundColor="{Binding StatusPillBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,4" HorizontalOptions="Start" VerticalOptions="Start" Margin="10">
                                                <Label Text="{Binding StatusLabel}" TextColor="{Binding StatusPillText}" FontSize="11" FontAttributes="Bold" />
                                            </Border>

                                            <!-- Facility Photo Label Badge -->
                                            <Border BackgroundColor="#CC0F172A" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="28" HeightRequest="28" Padding="6" HorizontalOptions="End" VerticalOptions="End" Margin="10">
                                                <Path Data="M9,2L7.17,4H4C2.9,4 2,4.9 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V6C22,4.9 21.1,4 20,4H16.83L15,2H9M12,17C9.24,17 7,14.76 7,12C7,9.24 9.24,7 12,7C14.76,7 17,9.24 17,12C17,14.76 14.76,17 12,17M12,9C10.35,9 9,10.35 9,12C9,13.65 10.35,15 12,15C13.65,15 15,13.65 15,12C15,10.35 13.65,9 12,9Z"
                                                      Fill="#FFFFFF"
                                                      WidthRequest="16"
                                                      HeightRequest="16"
                                                      Aspect="Uniform"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Name & Distance -->
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                                        <Label Text="{Binding Distance}" TextColor="#64748B" FontSize="13" />
                                    </VerticalStackLayout>

                                    <!-- Address Row -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                        <Label Grid.Column="0" Text="Address" TextColor="#64748B" FontSize="13" VerticalOptions="Start" />
                                        <Label Grid.Column="1" Text="{Binding Address}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Start" LineBreakMode="WordWrap" />
                                    </Grid>

                                    <!-- Verified by Row -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                        <Label Grid.Column="0" Text="Verified by" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding VerifiedBy}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Action Links Row -->
                                    <Border StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Padding="12" Margin="0,4,0,0">
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                            <HorizontalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding BindingContext.ViewMoreDetailsCommand, Source={x:Reference thisPage}}"
                                                    CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout.GestureRecognizers>
                                            <Label Text="View details &amp; route on Interactive Map" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#0A8491" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
